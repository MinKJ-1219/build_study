# 3주차 실습: 2주차 Bazel 프로젝트를 CI 파이프라인 위에 올린다.
# 로컬과 CI 러너가 같은 MODULE.bazel + .bazelversion을 읽기 때문에
# "어떤 Bazel로, 어떤 규칙 버전으로 빌드하는가"가 양쪽에서 동일하게 고정된다.
module(name = "week3_ci_demo", version = "0.1")

bazel_dep(name = "rules_cc", version = "0.2.25")

# 3-3 실습: 빌드 산출물을 tar로 묶는 규칙. 패키징도 빌드 그래프의 일부로 다룬다.
bazel_dep(name = "rules_pkg", version = "1.3.0")
