# 3주차 실습: 2주차 타겟 + 테스트 타겟
# CI의 test 단계가 의미를 가지려면 "실행해서 성공/실패를 판정할 대상"이 있어야 한다.

load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")

cc_library(
    name = "foo",
    srcs = ["foo.c"],
    hdrs = ["foo.h"],
)

cc_binary(
    name = "app",
    srcs = ["main.c"],
    deps = [":foo"],
)

# cc_test는 cc_binary와 거의 같지만 `bazel test`가 실행해서
# 종료 코드(0 = PASS, 그 외 = FAIL)로 결과를 판정한다.
# 외부 테스트 프레임워크(googletest 등) 없이 순수 C로 작성해 의존성을 최소화했다.
# size: 테스트 규모 선언(small=60초 제한). 생략하면 medium(300초)으로 간주돼
# "선언한 크기보다 훨씬 빨리 끝났다"는 경고가 뜬다. CI에서 타임아웃 기준이 되는 값.
cc_test(
    name = "foo_test",
    size = "small",
    srcs = ["foo_test.c"],
    deps = [":foo"],
)

# 3-2 실습: 이 바이너리를 컴파일한 툴체인 정보를 출력한다 (로컬 vs CI 비교용)
cc_binary(
    name = "toolchain_info",
    srcs = ["toolchain_info.c"],
)

# 3-2 실습: 로컬에서는 PASS, CI에서만 FAIL하는 테스트.
# testdata/expected.txt를 읽지만 data 속성으로 선언하지 않았다.
cc_test(
    name = "config_test",
    size = "small",
    srcs = ["config_test.c"],
    deps = [":foo"],
    data = ["testdata/expected.txt"],
)

# ---------------------------------------------------------------------------
# 3-3 실습: Package (빌드 산출물 → 배포 단위)
# ---------------------------------------------------------------------------

# 빌드 정보 파일. stamp = -1이면 `--stamp`일 때만 실제 git 정보가 들어가고,
# 아니면 고정 문구가 들어간다 → 평소 빌드는 캐시가 깨지지 않는다.
genrule(
    name = "build_info",
    outs = ["BUILD_INFO.txt"],
    cmd = select({
        ":stamped": "grep '^STABLE_' bazel-out/stable-status.txt > $@",
        "//conditions:default": "echo 'unstamped (build with --config=release)' > $@",
    }),
    stamp = -1,
)

config_setting(
    name = "stamped",
    values = {"stamp": "1"},
)

# app 실행 파일 + 빌드 정보를 하나의 tar로 묶는다.
# pkg_tar는 파일 mtime·소유자를 고정값으로 기록해서 같은 입력이면 비트 단위로 같은 tar가 나온다.
pkg_tar(
    name = "app_pkg",
    srcs = [
        ":app",
        ":build_info",
    ],
    package_dir = "app",
    extension = "tar.gz",
)

# ---------------------------------------------------------------------------
# 4-2 실습 (1): 벤더(Tier1) 코드 통합
# ---------------------------------------------------------------------------

# @vendor_a//:vendor_a_import는 소스 없이 헤더+사전 빌드된 .a만 노출하는 블랙박스 타겟이다.
# Bazel 입장에서는 일반 cc_library 의존성과 똑같이 다룬다 — 차이는 "안을 들여다볼 수 없다"는 것뿐.
cc_binary(
    name = "vendor_app",
    srcs = ["vendor_app.c"],
    deps = ["@vendor_a//:vendor_a_import"],
)

# ---------------------------------------------------------------------------
# 4-2 실습 (2): 변형(Variant) 관리 — select()로 리전별 다른 구현을 고른다
# ---------------------------------------------------------------------------

# `bazel build //:region_demo --define=region=us`를 줬을 때만 참이 된다.
config_setting(
    name = "region_us",
    values = {"define": "region=us"},
)

cc_library(
    name = "region_info",
    hdrs = ["region.h"],
    srcs = select({
        ":region_us": ["region_us.c"],
        "//conditions:default": ["region_eu.c"],
    }),
)

cc_binary(
    name = "region_demo",
    srcs = ["region_main.c"],
    deps = [":region_info"],
)
