# 4주차 실습: 3주차 CI 프로젝트를 확장해 SDV 특화 주제(멀티 타겟 크로스 컴파일,
# 벤더 모듈 통합, 변형 관리, SBOM)를 실습한다.
module(name = "week4_sdv_demo", version = "0.1")

bazel_dep(name = "rules_cc", version = "0.2.25")

# 3-3 실습: 빌드 산출물을 tar로 묶는 규칙. 패키징도 빌드 그래프의 일부로 다룬다.
bazel_dep(name = "rules_pkg", version = "1.3.0")

# 4-1 실습: platform()/toolchain()이 쓰는 @platforms//cpu, @platforms//os 제약조건.
# rules_cc가 간접적으로 이미 끌어오지만, 직접 참조하는 모듈이므로 명시적으로 선언한다.
bazel_dep(name = "platforms", version = "1.0.0")

# 4-1 실습: 등록해두면 `--platforms=//toolchain:aarch64_linux`를 줬을 때
# Bazel이 toolchain 플래그 없이도 이 aarch64 cc_toolchain을 자동으로 찾는다.
register_toolchains("//toolchain:cc_toolchain_for_aarch64")
